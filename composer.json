{
    "name": "laraarabdev/:package_slug",
    "description": ":package_description",
    "keywords": [
        "laravel",
        "laraarabdev",
        ":package_slug"
    ],
    "homepage": "https://github.com/LaraArabDev/:package_repo",
    "license": "MIT",
    "authors": [
        {
            "name": "LaraArabDev",
            "email": "dev@laraarab.dev",
            "homepage": "https://github.com/LaraArabDev"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^11.0|^12.0",
        "illuminate/database": "^11.0|^12.0",
        "illuminate/support": "^11.0|^12.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "LaraArabDev\\:package_namespace\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LaraArabDev\\:package_namespace\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "analyse": "vendor/bin/phpstan analyse",
        "format": "vendor/bin/pint",
        "format-test": "vendor/bin/pint --test"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaraArabDev\\:package_namespace\\:package_nameServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
